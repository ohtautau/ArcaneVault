@model ArcaneVault.Pages.Categories.CreateModel
@{
    ViewData["Title"] = "Create Category";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1>Create Category</h1>
        <p class="text-muted">Add a category to the Arcane Vault master list.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.CategoryCode" class="form-label"></label>
                <input asp-for="Input.CategoryCode" class="form-control" />
                <span asp-validation-for="Input.CategoryCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.CategoryName" class="form-label"></label>
                <input asp-for="Input.CategoryName" class="form-control" />
                <span asp-validation-for="Input.CategoryName" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
