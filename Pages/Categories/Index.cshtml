@model ArcaneVault.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Category Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Category Management</h1>
        <p class="text-muted mb-0">Manage the master list of collectible categories.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">Create Category</a>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

@if (Model.Categories.Count == 0)
{
    <div class="alert alert-info">No categories have been created.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Collection Items</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {
                    <tr>
                        <td>@category.CategoryCode</td>
                        <td>@category.CategoryName</td>
                        <td>@category.CollectionItemCount</td>
                        <td class="text-end">
                            <a asp-page="Details" asp-route-categoryCode="@category.CategoryCode"
                               class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-page="Edit" asp-route-categoryCode="@category.CategoryCode"
                               class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-page="Delete" asp-route-categoryCode="@category.CategoryCode"
                               class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
