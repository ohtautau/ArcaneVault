@model IReadOnlyList<ArcaneVault.Models.Responses.TradeItemResponse>
<div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Item</th><th>Type ID</th><th>Inventory ID</th><th>Quantity</th><th>Locked</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.ItemName</td><td><strong>@item.ItemTypeId</strong></td><td>@item.CollectionItemId@if (item.ReceivedCollectionItemId is int receivedId) { <small class="d-block text-muted">Received: @receivedId</small> }</td><td>@item.TradeQuantity</td><td>@(item.IsInTrade ? item.LockedQuantity : 0)</td></tr> }</tbody></table></div>
