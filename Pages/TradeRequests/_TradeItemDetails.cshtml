@model IReadOnlyList<ArcaneVault.Models.Responses.TradeItemResponse>
<div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Photo</th><th>Item</th><th>Type ID</th><th>Condition</th><th>Rarity</th><th>Inventory ID</th><th>Quantity</th><th>Locked</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@if (!string.IsNullOrWhiteSpace(item.ImagePath)) { <img src="@item.ImagePath" alt="Photo of @item.ItemName" width="48" height="48" class="rounded border" style="object-fit:cover" /> } else { <span class="text-muted">—</span> }</td><td>@item.ItemName</td><td><strong>@item.ItemTypeId</strong></td><td>@item.Condition</td><td>@item.Rarity</td><td>@item.CollectionItemId@if (item.ReceivedCollectionItemId is int receivedId) { <small class="d-block text-muted">Received: @receivedId</small> }</td><td>@item.TradeQuantity</td><td>@(item.IsInTrade ? item.LockedQuantity : 0)</td></tr> }</tbody></table></div>
