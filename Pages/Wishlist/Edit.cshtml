@page "{id:int}"
@model ArcaneVault.Pages.Wishlist.EditModel
@{ ViewData["Title"] = "Edit Wishlist Item"; }
<h1>Edit Wishlist Item</h1>
<form method="post" class="col-md-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Input.ItemName" class="form-label"></label><input asp-for="Input.ItemName" class="form-control" /><span asp-validation-for="Input.ItemName" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Input.DesiredQuantity" class="form-label"></label><input asp-for="Input.DesiredQuantity" class="form-control" /><span asp-validation-for="Input.DesiredQuantity" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Input.Notes" class="form-label"></label><textarea asp-for="Input.Notes" class="form-control" rows="4"></textarea><span asp-validation-for="Input.Notes" class="text-danger"></span></div>
    <button class="btn btn-primary">Save</button> <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
