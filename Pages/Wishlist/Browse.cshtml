@page
@model ArcaneVault.Pages.Wishlist.BrowseModel
@{ ViewData["Title"] = "Browse Wishlists"; }
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1>Browse Wishlists</h1><p class="text-muted">Discover what other collectors want and propose a trade.</p></div><a asp-page="Index" class="btn btn-outline-secondary">My Wishlist</a></div>
<form method="get" class="row g-2 mb-4"><div class="col-md-7"><input asp-for="Search" class="form-control" placeholder="Search username, wanted item, notes, or quantity" /></div><div class="col-auto"><button class="btn btn-outline-primary">Search</button><a asp-page="Browse" class="btn btn-outline-secondary">Clear</a></div></form>
@if (Model.Items.Count == 0) { <div class="alert alert-info">No wishlist items match this view.</div> }
else { <div class="wishlist-grid">@foreach (var item in Model.Items) { <article class="wishlist-card"><div><span class="wishlist-owner">@item.UserName's Wishlist</span><h2>@item.ItemName</h2><p class="mb-2"><strong>Wanted quantity:</strong> @item.DesiredQuantity</p><p>@(item.Notes ?? "No additional preferences.")</p></div><div><span class="badge text-bg-light me-2">@item.PendingTradeCount pending</span><a asp-page="/TradeRequests/Create" asp-route-wishlistItemId="@item.WishlistItemId" class="btn btn-sm btn-primary">Propose trade</a></div></article> }</div> }
