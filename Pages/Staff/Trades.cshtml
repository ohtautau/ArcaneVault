@page
@model ArcaneVault.Pages.Staff.TradesModel
@{ ViewData["Title"] = "Trade Oversight"; }
<h1>Trade Oversight</h1><p class="text-muted">Review all pending and accepted trades, intervene in disputes, and cancel unsafe transactions.</p>
<div asp-validation-summary="All" class="text-danger"></div>
@if (Model.Trades.Count == 0) { <div class="alert alert-info">There are no active trades.</div> }
else { @foreach (var trade in Model.Trades) { <article class="trade-card"><div class="trade-card-main"><span class="trade-status trade-status-@trade.Status.ToLowerInvariant()">@trade.Status</span><h2 class="h5">Trade #@trade.TradeId: @trade.RequesterUserName ↔ @trade.RecipientUserName</h2><p><strong>Offered:</strong> @string.Join(", ", trade.OfferedItems.Select(i => i.ItemName))<br/><strong>Requested:</strong> @string.Join(", ", trade.RequestedItems.Select(i => i.ItemName))</p><small class="text-muted">Created @trade.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm") UTC</small></div><form method="post" asp-page-handler="Cancel" asp-route-id="@trade.TradeId" class="trade-resolution"><label class="form-label">Intervention note</label><textarea asp-for="ResolutionNote" class="form-control mb-2" rows="2" required placeholder="Reason for Staff cancellation"></textarea><button class="btn btn-sm btn-danger">Cancel trade</button></form></article> } }
