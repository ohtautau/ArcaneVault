@model ArcaneVault.Pages.CollectionItems.EditModel
@{
    ViewData["Title"] = "Edit Collection Item";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1>Edit Collection Item</h1>

        <form method="post" enctype="multipart/form-data">
            <input type="hidden" name="itemId" value="@Model.ItemId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Inventory Record ID</label>
                <input class="form-control" value="@Model.ItemId" disabled />
            </div>
            <div class="mb-3"><label class="form-label">Permanent Item Type ID</label><input class="form-control" value="@Model.ItemTypeId" disabled /></div>

            <div class="mb-3">
                <label asp-for="Input.ItemName" class="form-label"></label>
                <input asp-for="Input.ItemName" class="form-control" readonly />
                <span asp-validation-for="Input.ItemName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Starting Quantity</label>
                <input class="form-control" value="@Model.StartingQuantity" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="Input.CurrentQuantity" class="form-label"></label>
                <input asp-for="Input.CurrentQuantity" class="form-control" />
                <span asp-validation-for="Input.CurrentQuantity" class="text-danger"></span>
            </div>

            <fieldset class="mb-3">
                <legend class="h6 visually-hidden">Item details</legend>
                <div class="row"><div class="col-md-6 mb-3"><label asp-for="Input.Condition" class="form-label"></label><select asp-for="Input.Condition" class="form-select"><option value="Mint">Mint — New / Perfect</option><option value="Good">Good</option><option value="Fair">Fair</option><option value="Poor">Poor</option></select></div><div class="col-md-6 mb-3"><label asp-for="Input.Rarity" class="form-label"></label><select asp-for="Input.Rarity" class="form-select"><option value="Common">Common</option><option value="Rare">Rare</option><option value="Ultra Rare">Ultra Rare</option></select></div></div>
                <div class="mb-3">@if (!string.IsNullOrWhiteSpace(Model.CurrentImagePath)) { <img src="@Model.CurrentImagePath" alt="Current photo" class="img-thumbnail d-block mb-2" style="max-width:240px;max-height:240px;object-fit:contain" /> }<label asp-for="Photo" class="form-label">Replace / add photo</label><input asp-for="Photo" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" /><span asp-validation-for="Photo" class="text-danger"></span><div class="form-text">Optional JPG, PNG, or WebP image, up to 5 MB.</div></div>
            </fieldset>

            <fieldset class="mb-3">
                <legend class="h6">Categories</legend>
                <span asp-validation-for="Input.CategoryCodes" class="text-danger d-block"></span>
                @foreach (var category in Model.Categories)
                {
                    var selected = Model.Input.CategoryCodes.Contains(
                        category.CategoryCode,
                        StringComparer.OrdinalIgnoreCase);
                    <div class="form-check">
                        @if (selected)
                        {
                            <input class="form-check-input" type="checkbox" checked
                                   name="Input.CategoryCodes" value="@category.CategoryCode"
                                   id="category_@category.CategoryCode" />
                        }
                        else
                        {
                            <input class="form-check-input" type="checkbox"
                                   name="Input.CategoryCodes" value="@category.CategoryCode"
                                   id="category_@category.CategoryCode" />
                        }
                        <label class="form-check-label" for="category_@category.CategoryCode">
                            @category.CategoryName (@category.CategoryCode)
                        </label>
                    </div>
                }
            </fieldset>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Details" asp-route-itemId="@Model.ItemId"
               class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
