@model ArcaneVault.Pages.CollectionItems.DeleteModel
@{
    ViewData["Title"] = "Delete Collection Item";
}

<h1>Delete Collection Item</h1>
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="alert alert-warning">
    Are you sure you want to delete this collection item? It will be hidden from normal views.
</div>

<dl class="row">
    <dt class="col-sm-3">Item Name</dt>
    <dd class="col-sm-9">@Model.Item.ItemName</dd>

    <dt class="col-sm-3">Owner</dt>
    <dd class="col-sm-9">@Model.Item.UserName</dd>

    <dt class="col-sm-3">Current Quantity</dt>
    <dd class="col-sm-9">@Model.Item.CurrentQuantity</dd>
</dl>

<form method="post">
    <input type="hidden" name="itemId" value="@Model.Item.ItemId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Details" asp-route-itemId="@Model.Item.ItemId"
       class="btn btn-outline-secondary">Cancel</a>
</form>
