@model ArcaneVault.Pages.CollectionItems.IndexModel
@{
    ViewData["Title"] = User.IsInRole("Staff") ? "Collection Items" : "My Collection";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="text-muted mb-0">
            @(User.IsInRole("Staff")
                ? "View and manage collection items for all users."
                : "View and manage the items in your collection.")
        </p>
    </div>
    <a asp-page="Create" class="btn btn-primary">Add Collection Item</a>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-sm-8 col-md-6">
        <label asp-for="Search" class="visually-hidden">Search collection items</label>
        <input asp-for="Search" class="form-control"
               placeholder="Search any item field or category" />
    </div>
    <div class="col-auto">
        <label asp-for="Days" class="visually-hidden">Quantity change period</label>
        <select asp-for="Days" class="form-select" aria-label="Quantity change period" onchange="this.form.submit()">
            <option value="1">Last 1 day</option>
            <option value="3">Last 3 days</option>
            <option value="7">Last week</option>
            <option value="30">Last month</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-page="Index" asp-route-days="@Model.Days" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Search))
{
    <p class="text-muted">
        @Model.Items.Count result(s) for <strong>@Model.Search.Trim()</strong>
    </p>
}

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">
        @(string.IsNullOrWhiteSpace(Model.Search)
            ? "No collection items have been added."
            : "No collection items match your search.")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Photo</th>
                    <th>Item Type ID</th>
                    <th>Inventory ID</th>
                    <th>Name</th>
                    <th>Condition</th><th>Rarity</th>
                    @if (User.IsInRole("Staff"))
                    {
                        <th>Owner</th>
                    }
                    <th>Starting</th>
                    <th>Current</th>
                    <th>Locked</th>
                    <th>Available</th>
                    @if (!User.IsInRole("Staff")) { <th>Recent Change</th> }
                    <th>Categories</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@if (!string.IsNullOrWhiteSpace(item.ImagePath)) { <img src="@item.ImagePath" alt="Photo of @item.ItemName" class="rounded border" width="56" height="56" style="object-fit:cover" /> } else { <span class="text-muted">—</span> }</td>
                        <td><strong>@item.ItemTypeId</strong></td>
                        <td>@item.ItemId</td>
                        <td>@item.ItemName</td>
                        <td>@item.Condition</td><td><span class="badge @(item.Rarity == "Ultra Rare" ? "text-bg-warning" : item.Rarity == "Rare" ? "text-bg-info" : "text-bg-secondary")">@item.Rarity</span></td>
                        @if (User.IsInRole("Staff"))
                        {
                            <td>@item.UserName</td>
                        }
                        <td>@item.StartingQuantity</td>
                        <td>@item.CurrentQuantity</td>
                        <td>@item.LockedQuantity</td>
                        <td>@(item.CurrentQuantity - item.LockedQuantity)</td>
                        @if (!User.IsInRole("Staff"))
                        {
                            <td>
                                @if (item.RecentQuantityChange > 0) { <span class="fw-semibold text-success">+@item.RecentQuantityChange</span> }
                                else if (item.RecentQuantityChange < 0) { <span class="fw-semibold text-danger">@item.RecentQuantityChange</span> }
                                else { <span class="text-muted">0</span> }
                            </td>
                        }
                        <td>@string.Join(", ", item.Categories.Select(category => category.CategoryName))</td>
                        <td class="text-end">
                            <a asp-page="Details" asp-route-itemId="@item.ItemId"
                               class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-page="Edit" asp-route-itemId="@item.ItemId"
                               class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-page="Delete" asp-route-itemId="@item.ItemId"
                               class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
